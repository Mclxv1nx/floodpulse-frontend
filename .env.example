# Copiar a .env y ajustar. Las variables PUBLIC_* se exponen al navegador.

# Motor 1: backend de riesgo (uvicorn src.main:app -> puerto 8000)
PUBLIC_API_BASE=http://localhost:8000

# Motor 2: API de suscriptores del modulo de alertas (puerto 8100)
PUBLIC_SUBS_API_BASE=http://localhost:8100
# Debe ser la MISMA clave que API_KEY en floodpulse-alerts/.env
PUBLIC_SUBS_API_KEY=floodpulse-dev-key
